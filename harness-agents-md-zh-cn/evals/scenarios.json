{
  "version": 1,
  "skill": "harness-agents-md-zh-cn",
  "scenarios": [
    {
      "id": "create-from-present-global",
      "prompt": "我的全局 AGENTS.md 是英文。请创建一份简洁的项目 AGENTS.md，并忠实沿用全局规则。",
      "expected_trigger": true,
      "critical_boundaries": [
        "现有全局指令是精确基准",
        "保留源语言和阈值",
        "不混入内置 fallback",
        "最小且有用的修改"
      ]
    },
    {
      "id": "create-from-missing-global",
      "prompt": "这台机器没有全局 AGENTS.md。请使用内置工程 fallback 创建一份。",
      "expected_trigger": true,
      "expected_fallback": "assets/AGENTS.example.md",
      "critical_boundaries": [
        "选择 fallback 并继续",
        "保护无关修改",
        "只委派独立且不冲突的工作流",
        "协调者负责集成和最终验证",
        "文件和模块排他所有权",
        "执行 Agent 运行最小针对性检查",
        "不机械设置固定角色"
      ]
    },
    {
